#: includes/Sync/Categories.php:124
#: includes/Sync/CategoryPush.php:102
msgid "WooCommerce product categories are not available."
msgstr "WooCommerce-Produktkategorien stehen nicht zur Verfügung."

#: includes/Sync/Categories.php:133
msgid "No Kontor shop has been selected, so there is no category tree to import."
msgstr "Es wurde kein Kontor-Shop ausgewählt, daher gibt es keinen Kategoriebaum zu importieren."

#: includes/Sync/Categories.php:170
msgid "Kontor returned no categories for this shop."
msgstr "Kontor hat für diesen Shop keine Kategorien zurückgegeben."

#: includes/Sync/CategoryPush.php:128
msgid "This shop has no product categories to send."
msgstr "Dieser Shop hat keine Produktkategorien zum Senden."

#. translators: 1: number of categories in the shop, 2: the largest number that can be sent.
#: includes/Sync/CategoryPush.php:137
#, php-format
msgid "Nothing was sent: this shop has %1$d product categories and at most %2$d can be sent at once. Sending part of the tree would ask Kontor to delete the rest, along with the product assignments on it."
msgstr "Es wurde nichts gesendet: Dieser Shop hat %1$d Produktkategorien, und es können höchstens %2$d auf einmal gesendet werden. Nur einen Teil des Baums zu senden hieße, Kontor um das Löschen des Rests zu bitten — samt der Produktzuordnungen daran."

#: includes/Sync/CategoryPush.php:187
msgid "No Kontor shop has been selected. Choose one before sending categories."
msgstr "Es wurde kein Kontor-Shop ausgewählt. Wähle einen aus, bevor du Kategorien sendest."

#. translators: %d: number of articles Kontor files under no category.
#: includes/Sync/ProductSync.php:1084
#, php-format
msgid "Held %d back as drafts for belonging to no category."
msgstr "%d als Entwürfe zurückgehalten, weil sie zu keiner Kategorie gehören."

#: includes/Sync/ProductSync.php:457
msgid "The catalogue did not end. The run was stopped rather than draft the articles it never reached."
msgstr "Der Katalog nahm kein Ende. Der Lauf wurde gestoppt, statt die nie gelesenen Artikel zu entwerfen."

#. translators: 1: number of attempts made, 2: the reason the last one failed.
#: includes/Sync/ProductSync.php:625
#, php-format
msgid "Gave up after %1$d attempts: %2$s"
msgstr "Nach %1$d Versuchen aufgegeben: %2$s"

#. translators: 1: articles this run read, 2: articles the last completed run read.
#: includes/Sync/ProductSync.php:720
#, php-format
msgid "Kontor listed %1$d articles, down from %2$d. Nothing was drafted: run the sync again, and if the catalogue really has shrunk the next run will go ahead."
msgstr "Kontor listete %1$d Artikel auf, zuvor %2$d. Es wurde nichts auf Entwurf gesetzt: Starte die Synchronisierung erneut — ist der Katalog wirklich kleiner geworden, führt der nächste Lauf sie durch."
