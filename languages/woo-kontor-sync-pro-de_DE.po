#. translators: 1: timestamp, 2: run summary.
#: includes/Admin/Settings.php:1643
#, php-format
msgid "Succeeded at %1$s — %2$s"
msgstr "Erfolgreich am %1$s — %2$s"

#: includes/Admin/Settings.php:1792
msgid "The job could not be queued. It may already be running, or WooCommerce may be inactive."
msgstr "Der Job konnte nicht eingereiht werden. Möglicherweise läuft er bereits oder WooCommerce ist nicht aktiv."

#. translators: %s: job name.
#: includes/Admin/Settings.php:1804
#, php-format
msgid "%s queued. It runs on the next queue pass, within a minute or so."
msgstr "%s eingereiht. Der Job läuft beim nächsten Warteschlangendurchlauf, also in etwa einer Minute."

