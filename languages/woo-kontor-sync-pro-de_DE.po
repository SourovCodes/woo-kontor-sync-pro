#, php-format
msgid "%1$d sent, %2$d already in Kontor, %3$d rejected."
msgstr "%1$d gesendet, %2$d bereits in Kontor, %3$d abgelehnt."

#: includes/Sync/OrderSync.php:547
msgid "Already present in Kontor; not sent again."
msgstr "Bereits in Kontor vorhanden, nicht erneut gesendet."

#. translators: %s: Kontor's internal order number.
#: includes/Sync/OrderSync.php:550
#, php-format
msgid "Sent to Kontor as %s."
msgstr "An Kontor gesendet als %s."

#: includes/Sync/Preflight.php:97
msgid "Kontor is not configured: set the API base URL and API key before running a sync."
msgstr "Kontor ist nicht konfiguriert: Lege die API-Basis-URL und den API-Schlüssel fest, bevor du eine Synchronisation startest."

#: includes/Sync/Preflight.php:116
msgid "No Kontor shop has been selected. Choose one on the settings screen before syncing orders."
msgstr "Es wurde kein Kontor-Shop ausgewählt. Wähle auf der Einstellungsseite einen aus, bevor du Bestellungen synchronisierst."

#. translators: 1: created count, 2: updated count, 3: unchanged count, 4: drafted count.
#: includes/Sync/ProductSync.php:370
#, php-format
msgid "%1$d created, %2$d updated, %3$d unchanged, %4$d drafted."
msgstr "%1$d erstellt, %2$d aktualisiert, %3$d unverändert, %4$d auf Entwurf gesetzt."

#: includes/Sync/Scheduler.php:140
msgid "Imports articles, titles, descriptions and prices from Kontor."
msgstr "Importiert Artikel, Titel, Beschreibungen und Preise aus Kontor."

#: includes/Sync/Scheduler.php:141
#: includes/Sync/Scheduler.php:149
#: includes/Sync/Scheduler.php:166
#: includes/Sync/Scheduler.php:175
msgid "From Kontor"
msgstr "Aus Kontor"

#: includes/Sync/Scheduler.php:156
msgid "Sends paid orders to Kontor. Orders are normally sent as they are paid; this sweep catches any that were missed."
msgstr "Sendet bezahlte Bestellungen an Kontor. Bestellungen werden normalerweise gesendet, sobald sie bezahlt sind, dieser Durchlauf erfasst übersehene."

#: includes/Sync/Scheduler.php:157
msgid "To Kontor"
msgstr "An Kontor"

#: includes/Sync/Scheduler.php:165
msgid "Brings order status and tracking details back from Kontor. Completing an order emails the customer."
msgstr "Holt Bestellstatus und Sendungsdaten aus Kontor zurück. Das Abschließen einer Bestellung sendet dem Kunden eine E-Mail."

#: includes/Sync/StockSync.php:138
msgid "Kontor reported no stock levels."
msgstr "Kontor hat keine Lagerbestände gemeldet."

#: includes/Sync/StockSync.php:172
msgid "The cached stock payload expired before it could be applied."
msgstr "Die zwischengespeicherten Bestandsdaten sind abgelaufen, bevor sie übernommen werden konnten."

#: woo-kontor-sync-pro.php:60
msgid "Woo Kontor Sync Pro is missing its dependencies. Run \"composer install\" in the plugin directory."
msgstr "Woo Kontor Sync Pro fehlen seine Abhängigkeiten. Führe „composer install“ im Plugin-Verzeichnis aus."

#. translators: %s: minimum supported WooCommerce version.
#: woo-kontor-sync-pro.php:78
#, php-format
msgid "Woo Kontor Sync Pro requires WooCommerce %s or newer to be installed and active."
msgstr "Woo Kontor Sync Pro benötigt WooCommerce %s oder neuer, installiert und aktiv."

#: woo-kontor-sync-pro.php:93
msgid "Woo Kontor Sync Pro requires High-Performance Order Storage. Synchronisation with Kontor stays disabled until it is enabled."
msgstr "Woo Kontor Sync Pro benötigt High-Performance Order Storage (HPOS). Die Synchronisation mit Kontor bleibt deaktiviert, bis HPOS aktiviert ist."

#: woo-kontor-sync-pro.php:98
msgid "Enable High-Performance Order Storage"
msgstr "High-Performance Order Storage aktivieren"

#: includes/Admin/Settings.php:1315
#: includes/Sync/Scheduler.php:173
msgid "Invoice sync"
msgstr "Rechnungssynchronisation"

#: includes/Admin/Settings.php:1326
msgid "Downloads invoice PDFs from Kontor and needs a shop selected. Each invoice is stored privately, shown to the customer on their order, and attached to the order emails sent after it arrives."
msgstr "Lädt Rechnungs-PDFs von Kontor herunter und benötigt einen ausgewählten Shop. Jede Rechnung wird geschützt gespeichert, der Kundschaft bei ihrer Bestellung angezeigt und den Bestell-E-Mails angehängt, die danach versendet werden."

#: includes/Frontend/Invoices.php:63
#: includes/Frontend/Invoices.php:112
#: includes/Frontend/Invoices.php:132
msgid "Invoices"
msgstr "Rechnungen"

#: includes/Frontend/Invoices.php:71
msgid "Download PDF"
msgstr "PDF herunterladen"

#. translators: 1: invoice label with its number and date, 2: download URL.
#: includes/Frontend/Invoices.php:137
#, php-format
msgid "%1$s: %2$s"
msgstr "%1$s: %2$s"

#: includes/Frontend/Invoices.php:215
msgid "Invoice"
msgstr "Rechnung"

#. translators: %s: invoice number.
#: includes/Frontend/Invoices.php:220
#, php-format
msgid "Invoice %s"
msgstr "Rechnung %s"

#. translators: 1: invoice number, 2: date the invoice was issued.
#: includes/Frontend/Invoices.php:232
#, php-format
msgid "Invoice %1$s of %2$s"
msgstr "Rechnung %1$s vom %2$s"

#: includes/Invoices/Download.php:117
msgid "That order could not be found."
msgstr "Diese Bestellung wurde nicht gefunden."

#: includes/Invoices/Download.php:126
msgid "You do not have permission to download this invoice."
msgstr "Du hast keine Berechtigung, diese Rechnung herunterzuladen."

#: includes/Invoices/Download.php:132
msgid "That invoice is not available for this order."
msgstr "Diese Rechnung ist für diese Bestellung nicht verfügbar."

#: includes/Invoices/Download.php:208
msgid "Invoice unavailable"
msgstr "Rechnung nicht verfügbar"

#: includes/Invoices/Storage.php:102
msgid "Kontor returned a document that is not a PDF."
msgstr "Kontor hat ein Dokument zurückgegeben, das kein PDF ist."

#: includes/Invoices/Storage.php:117
msgid "The invoice could not be written: WordPress has no direct filesystem access."
msgstr "Die Rechnung konnte nicht gespeichert werden: WordPress hat keinen direkten Dateisystemzugriff."

#: includes/Invoices/Storage.php:126
msgid "The invoice could not be written to the uploads directory."
msgstr "Die Rechnung konnte nicht in das Uploads-Verzeichnis geschrieben werden."

#: includes/Invoices/Storage.php:148
msgid "No invoice file is recorded."
msgstr "Es ist keine Rechnungsdatei hinterlegt."

#: includes/Invoices/Storage.php:161
msgid "The invoice file is no longer on disk."
msgstr "Die Rechnungsdatei liegt nicht mehr auf dem Datenträger."

#: includes/Invoices/Storage.php:165
msgid "The recorded invoice path is not inside the invoice directory."
msgstr "Der hinterlegte Rechnungspfad liegt nicht im Rechnungsverzeichnis."

#: includes/Invoices/Storage.php:193
msgid "The uploads directory is not writable, so invoices cannot be stored."
msgstr "Das Uploads-Verzeichnis ist nicht beschreibbar, daher können keine Rechnungen gespeichert werden."

#: includes/Invoices/Storage.php:213
